{
  "provider": "anthropic",
  "display_name": "Anthropic (Claude)",
  "adapter": "native-messages",
  "base_url": "https://api.anthropic.com",
  "endpoints": { "chat": "/v1/messages" },
  "auth": {
    "scheme": "header",
    "header": "x-api-key",
    "extra_headers": { "anthropic-version": "2023-06-01" }
  },
  "streaming": "anthropic-sse-blocks",
  "tool_schema": "anthropic-input-schema",
  "notes": [
    "system is a top-level field, not a message; max_tokens is REQUIRED.",
    "tools are {name, description, input_schema}; tool_choice is {type: auto|any|tool|none, name?}.",
    "SSE: message_start > content_block_start > content_block_delta(text/thinking/input_json) > content_block_stop > message_delta(stop_reason+usage) > message_stop; rebuild into OpenAI chunks + [DONE].",
    "stop_reason map: end_turn->stop, max_tokens->length, tool_use->tool_calls, stop_sequence->stop, refusal->content_filter.",
    "An OpenAI-compatible /v1/ base exists but is labeled test/eval-only, non-production -> use the native adapter.",
    "prompt caching via cache_control{type:ephemeral,ttl?}; cache_read ~=0.1x input, cache_write ~=1.25x (5m)/2x (1h)."
  ],
  "verification": {
    "shape": "high",
    "shape_source": "first-party docs (platform.claude.com), fetched 2026-07",
    "pricing": "high",
    "pricing_source": "first-party (claude-api reference), 2026-07"
  },
