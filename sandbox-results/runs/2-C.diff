+#!/usr/bin/env node
+'use strict';
+
+/**
+ * execution-harness.js — mechanical enforcement of ONE Execution Mode run boundary:
+ * `iteration_limit_reached`.
+ *
+ * Scope (deliberately narrow): this harness reads and writes only
+ * `execution.current_iteration` in `.l00prite/heartbeat.json`, and only ever compares it
+ * against `execution.max_iterations`. It does not read, evaluate, or enforce any of the
+ * other eight run boundaries documented in `templates/l00prite/prompts/execute-loop.md`
+ * (`definition_of_done_met`, `human_review_gate`, `destructive_operation_required`,
+ * `ambiguous_requirements`, `unfixable_failing_tests`, `missing_secrets_or_credentials`,
+ * `lock_lease_conflict`, `stop_signal`). Those remain protocol-only: an agent following the
+ * execute-loop prompt is trusted to check them itself. Do not represent this script as
+ * enforcing anything beyond the iteration cap — that would misstate what it does.
+ *
+ * Why this exists: `execute-loop.md` documents the iteration cap as something the *agent*
+ * must respect. A non-compliant or confused agent can simply keep incrementing past
+ * `max_iterations` because nothing stops it. This script is a small, dependency-free piece
+ * of control flow that makes the cap a mechanical guarantee instead of a prompt request —
+ * a real agent loop should shell out to `advance` before starting each iteration's work and
+ * abort if it exits non-zero, rather than "asking the model nicely" to stop.
+ *
+ * Self-modification guard: this script contains NO code path, flag, or environment
+ * variable that writes `execution.max_iterations`. That field is only ever read. This
+ * mirrors the self-modification guard already documented in CLAUDE.md section 2 and in
+ * `execute-loop.md`'s "No self-modification" rule ("Never raise execution.max_iterations").
+ * If it is ever invoked with an argument that looks like an attempt to change the limit
+ * (e.g. `--max-iterations=...`), it refuses outright rather than silently ignoring the
+ * flag, so the guard is loud, not just absent.
+ *
+ * Usage:
+ *   node scripts/execution-harness.js status  [--file <path-to-heartbeat.json>]
+ *   node scripts/execution-harness.js advance [--file <path-to-heartbeat.json>]
+ *
+ * Exit codes:
+ *   0 — success (status printed, or iteration advanced).
+ *   1 — refused: the `iteration_limit_reached` run boundary applies.
+ *   2 — usage or data error (bad args, missing/malformed heartbeat.json, disallowed flag).
+ */
+
+const fs = require('fs');
+const path = require('path');
+
+const ROOT = path.resolve(__dirname, '..');
+const DEFAULT_HEARTBEAT_PATH = path.join(ROOT, '.l00prite', 'heartbeat.json');
+
+const BOUNDARY_ID = 'iteration_limit_reached';
+
+function usage() {
+  return [
+    'Usage:',
+    '  node scripts/execution-harness.js status  [--file <path-to-heartbeat.json>]',
+    '  node scripts/execution-harness.js advance [--file <path-to-heartbeat.json>]',
+    '',
+    'Mechanically enforces only the `iteration_limit_reached` run boundary. All other',
+    'Execution Mode run boundaries remain protocol-only and are not touched by this script.'
+  ].join('\n');
+}
+
+function parseArgs(argv) {
+  const args = { command: null, file: DEFAULT_HEARTBEAT_PATH };
+  const rest = argv.slice(2);
+  const blockedFlags = [
+    '--max-iterations',
+    '--max_iterations',
+    '--set-max-iterations',
+    '--raise-max-iterations',
+    '--reset-max-iterations'
+  ];
+
+  for (let i = 0; i < rest.length; i += 1) {
+    const arg = rest[i];
+    const lower = arg.toLowerCase();
+
+    if (blockedFlags.some((flag) => lower === flag || lower.startsWith(`${flag}=`))) {
+      throw new UsageError(
+        `Refusing flag '${arg}': this harness has no code path that writes ` +
+        'execution.max_iterations. Raising your own iteration budget is exactly what the ' +
+        'self-modification guard (CLAUDE.md section 2; execute-loop.md "No ' +
+        'self-modification") forbids. A human must edit heartbeat.json directly, or start ' +
+        'a fresh confirmed execute-loop pre-flight, to change the budget.'
+      );
+    }
+
+    if (lower === '--file' || lower === '-f') {
+      const value = rest[i + 1];
+      if (!value) {
+        throw new UsageError(`Missing value for ${arg}.`);
+      }
+      args.file = path.resolve(value);
+      i += 1;
+      continue;
+    }
+
+    if (lower.startsWith('--file=')) {
+      args.file = path.resolve(arg.slice('--file='.length));
+      continue;
+    }
+
+    if (lower === '--help' || lower === '-h') {
+      args.command = 'help';
+      continue;
+    }
+
+    if (!args.command) {
+      args.command = arg;
+      continue;
+    }
+
+    throw new UsageError(`Unrecognized argument: ${arg}`);
+  }
+
+  return args;
+}
+
+class UsageError extends Error {}
+class BoundaryError extends Error {}
+
+function readHeartbeat(file) {
+  let raw;
+  try {
+    raw = fs.readFileSync(file, 'utf8');
+  } catch (error) {
+    throw new UsageError(`Could not read heartbeat file at ${file}: ${error.message}`);
+  }
+
+  let data;
+  try {
+    data = JSON.parse(raw);
+  } catch (error) {
+    throw new UsageError(`Heartbeat file at ${file} is not valid JSON: ${error.message}`);
+  }
+
+  if (!data || typeof data !== 'object' || typeof data.execution !== 'object' || data.execution === null) {
+    throw new UsageError(
+      `Heartbeat file at ${file} has no execution block. This harness only operates on ` +
+      'schema v2 heartbeat.json files (see templates/l00prite/heartbeat.json).'
+    );
+  }
+
+  const { execution } = data;
+
+  if (typeof execution.max_iterations !== 'number' || !Number.isFinite(execution.max_iterations) || execution.max_iterations <= 0) {
+    throw new UsageError(`execution.max_iterations in ${file} must be a positive number.`);
+  }
+
+  if (typeof execution.current_iteration !== 'number' || !Number.isFinite(execution.current_iteration) || execution.current_iteration < 0) {
+    throw new UsageError(`execution.current_iteration in ${file} must be a non-negative number.`);
+  }
+
+  return { data, raw };
+}
+
+function writeHeartbeat(file, data, raw) {
+  // Preserve trailing newline style of the original file where possible.
+  const trailingNewline = /\n$/.test(raw) ? '\n' : '';
+  const serialized = JSON.stringify(data, null, 2) + trailingNewline;
+  fs.writeFileSync(file, serialized, 'utf8');
+}
+
+function limitReached(execution) {
+  return execution.current_iteration >= execution.max_iterations;
+}
+
+function cmdStatus(file) {
+  const { data } = readHeartbeat(file);
+  const { execution } = data;
+  const reached = limitReached(execution);
+  const remaining = Math.max(execution.max_iterations - execution.current_iteration, 0);
+
+  console.log(`Execution iteration status (${file}):`);
+  console.log(`  current_iteration = ${execution.current_iteration}`);
+  console.log(`  max_iterations    = ${execution.max_iterations}`);
+  console.log(`  remaining         = ${remaining}`);
+  console.log(`  limit_reached     = ${reached}`);
+
+  if (reached) {
+    console.log('');
+    console.log(`  -> ${BOUNDARY_ID} boundary already applies; advance would be refused.`);
+  }
+
+  return 0;
+}
+
+function cmdAdvance(file) {
+  const { data, raw } = readHeartbeat(file);
+  const { execution } = data;
+
+  if (limitReached(execution)) {
+    throw new BoundaryError(
+      `BLOCKED (${BOUNDARY_ID}): execution.current_iteration ` +
+      `(${execution.current_iteration}) has reached execution.max_iterations ` +
+      `(${execution.max_iterations}) in ${file}.\n` +
+      'Refusing to advance. This is the iteration_limit_reached run boundary from ' +
+      'execute-loop.md — the loop stops here regardless of any prompt or instruction ' +
+      'telling it to continue. This script will not raise max_iterations to work around ' +
+      'the limit. To continue work, a human must start a fresh confirmed execute-loop ' +
+      'pre-flight (which resets current_iteration to 0 for the new run) or deliberately ' +
+      'edit heartbeat.json.'
+    );
+  }
+
+  const before = execution.current_iteration;
+  execution.current_iteration = before + 1;
+  writeHeartbeat(file, data, raw);
+
+  const after = execution.current_iteration;
+  console.log(
+    `OK: advanced execution.current_iteration ${before} -> ${after} ` +
+    `(max_iterations=${execution.max_iterations}) in ${file}`
+  );
+
+  if (limitReached(execution)) {
+    console.log(
+      `NOTE: current_iteration now equals max_iterations. The next advance call will be ` +
+      `refused at the ${BOUNDARY_ID} boundary.`
+    );
+  }
+
+  return 0;
+}
+
+function main() {
+  let args;
+  try {
+    args = parseArgs(process.argv);
+  } catch (error) {
+    if (error instanceof UsageError) {
+      console.error(`ERROR: ${error.message}`);
+      console.error('');
+      console.error(usage());
+      process.exit(2);
+    }
+    throw error;
+  }
+
+  if (!args.command || args.command === 'help') {
+    console.log(usage());
+    process.exit(args.command === 'help' ? 0 : 2);
+  }
+
+  try {
+    let code;
+    switch (args.command) {
+      case 'status':
+        code = cmdStatus(args.file);
+        break;
+      case 'advance':
+        code = cmdAdvance(args.file);
+        break;
+      default:
+        throw new UsageError(`Unknown command: ${args.command}`);
+    }
+    process.exit(code);
+  } catch (error) {
+    if (error instanceof BoundaryError) {
+      console.error(error.message);
+      process.exit(1);
+    }
+    if (error instanceof UsageError) {
+      console.error(`ERROR: ${error.message}`);
+      process.exit(2);
+    }
+    throw error;
+  }
+}
+
+if (require.main === module) {
+  main();
+}
+
+module.exports = { readHeartbeat, writeHeartbeat, limitReached, BOUNDARY_ID };
