index 0000000..9deaaa1
--- /dev/null
+++ b/scripts/execution-harness.test.js
@@ -0,0 +1,210 @@
+#!/usr/bin/env node
+'use strict';
+
+/**
+ * Self-contained smoke test for scripts/execution-harness.js.
+ *
+ * Dependency-free: only Node's built-in assert/strict, child_process, fs, os, path
+ * modules, matching the conservatism of scripts/validate-l00prite.js. Not wired into any
+ * CI (none exists yet in this repo — see .l00prite/todos.md) or into
+ * scripts/validate-l00prite.js (a human-review-gated file). Run manually:
+ *
+ *   node scripts/execution-harness.test.js
+ *
+ * Exits 0 with a summary line if every assertion passes; an assertion failure throws and
+ * Node exits non-zero with a stack trace, the same "no framework" style as
+ * scripts/validate-l00prite.js.
+ */
+
+const assert = require('assert/strict');
+const { execFileSync } = require('child_process');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+
+const HARNESS = path.resolve(__dirname, 'execution-harness.js');
+
+function writeHeartbeat(dir, execution, extra) {
+  const file = path.join(dir, 'heartbeat.json');
+  const data = Object.assign(
+    { schema_version: 2, max_iterations: 20, current_iteration: 9 },
+    extra || {}
+  );
+  if (execution !== null) {
+    data.execution = Object.assign(
+      {
+        enabled: true,
+        preflight_confirmed: true,
+        preflight_confirmed_at: '2026-07-03T00:00:00Z',
+        preflight_confirmed_by: 'test',
+        last_run_boundary: null,
+        run_boundaries: [
+          'definition_of_done_met',
+          'iteration_limit_reached',
+          'human_review_gate',
+          'destructive_operation_required',
+          'ambiguous_requirements',
+          'unfixable_failing_tests',
+          'missing_secrets_or_credentials',
+          'lock_lease_conflict',
+          'stop_signal'
+        ]
+      },
+      execution
+    );
+  }
+  fs.writeFileSync(file, JSON.stringify(data, null, 2) + '\n');
+  return file;
+}
+
+function run(args) {
+  try {
+    const stdout = execFileSync('node', [HARNESS, ...args], { encoding: 'utf8' });
+    return { code: 0, stdout, stderr: '' };
+  } catch (error) {
+    return {
+      code: typeof error.status === 'number' ? error.status : -1,
+      stdout: error.stdout ? error.stdout.toString() : '',
+      stderr: error.stderr ? error.stderr.toString() : ''
+    };
+  }
+}
+
+function readFile(file) {
+  return fs.readFileSync(file, 'utf8');
+}
+
+let passCount = 0;
+function pass(label) {
+  passCount++;
+  console.log(`PASS ${label}`);
+}
+
+const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'l00prite-harness-test-'));
+
+try {
+  // --- (1) advance under the cap exits 0 and increments current_iteration by exactly 1.
+  {
+    const file = writeHeartbeat(tmpDir, { max_iterations: 5, current_iteration: 2 });
+    const before = JSON.parse(readFile(file));
+    const result = run(['advance', '--heartbeat', file]);
+    assert.equal(result.code, 0, 'advance under cap should exit 0');
+    const after = JSON.parse(readFile(file));
+    assert.equal(after.execution.current_iteration, before.execution.current_iteration + 1,
+      'current_iteration should increment by exactly 1');
+    pass('advance under the cap exits 0 and increments current_iteration by exactly 1');
+  }
+
+  // --- (2) advance at the cap exits 1, stderr names iteration_limit_reached, file byte-identical.
+  {
+    const file = writeHeartbeat(tmpDir, { max_iterations: 3, current_iteration: 3 });
+    const before = readFile(file);
+    const result = run(['advance', '--heartbeat', file]);
+    assert.equal(result.code, 1, 'advance at the cap should exit 1');
+    assert.ok(result.stderr.includes('iteration_limit_reached'),
+      'stderr should contain the literal string iteration_limit_reached');
+    const after = readFile(file);
+    assert.equal(after, before, 'file must be byte-identical after a refused advance');
+    pass('advance at the cap exits 1, stderr names iteration_limit_reached, file untouched (byte-identical)');
+  }
+
+  // --- (2b) advance when current_iteration is already PAST the cap (corrupted state) also refuses via exit 1.
+  {
+    const file = writeHeartbeat(tmpDir, { max_iterations: 3, current_iteration: 5 });
+    const before = readFile(file);
+    const result = run(['advance', '--heartbeat', file]);
+    assert.equal(result.code, 1, 'advance past the cap should still exit 1 (>=, not ==)');
+    assert.ok(result.stderr.includes('iteration_limit_reached'));
+    assert.equal(readFile(file), before, 'file must be untouched');
+    pass('advance with current_iteration already past max_iterations refuses via exit 1 (>= comparison)');
+  }
+
+  // --- (3) execution.max_iterations never changes across any sequence of status/advance calls.
+  {
+    const file = writeHeartbeat(tmpDir, { max_iterations: 4, current_iteration: 0 });
+    const originalMax = JSON.parse(readFile(file)).execution.max_iterations;
+    const sequence = ['status', 'advance', 'status', 'advance', 'advance', 'advance', 'advance', 'status'];
+    for (const cmd of sequence) {
+      run([cmd, '--heartbeat', file]);
+      const current = JSON.parse(readFile(file)).execution.max_iterations;
+      assert.equal(current, originalMax,
+        `execution.max_iterations must never change (command was "${cmd}")`);
+    }
+    // Confirm the run did actually advance to and past the cap, proving the sequence was
+    // a meaningful exercise of the guard, not a no-op.
+    const finalState = JSON.parse(readFile(file));
+    assert.equal(finalState.execution.current_iteration, 4, 'sequence should have advanced to the cap');
+    pass('execution.max_iterations never changes across a sequence of status/advance calls (self-modification guard, empirically proven)');
+  }
+
+  // --- (4) status never mutates the file (hash/byte-compare before/after).
+  {
+    const file = writeHeartbeat(tmpDir, { max_iterations: 10, current_iteration: 5 });
+    const before = readFile(file);
+    const result = run(['status', '--heartbeat', file]);
+    assert.equal(result.code, 0, 'status should exit 0');
+    const after = readFile(file);
+    assert.equal(after, before, 'status must never write to the file');
+    pass('status never mutates the file');
+  }
+
+  // --- (4b) status at/beyond the cap still exits 0 and reports limit_reached: true (not an error).
+  {
+    const file = writeHeartbeat(tmpDir, { max_iterations: 2, current_iteration: 2 });
+    const result = run(['status', '--heartbeat', file, '--json']);
+    assert.equal(result.code, 0, 'status at the cap should still exit 0 (reporting only)');
+    const parsed = JSON.parse(result.stdout);
+    assert.equal(parsed.limit_reached, true, 'status --json should report limit_reached: true');
+    pass('status at/beyond the cap exits 0 and reports limit_reached: true (status never enforces)');
+  }
+
+  // --- (5) a heartbeat.json with no execution block exits 2 with a distinct message.
+  {
+    const file = writeHeartbeat(tmpDir, null);
+    // writeHeartbeat with execution=null omits the execution key entirely.
+    const data = JSON.parse(readFile(file));
+    assert.ok(!('execution' in data), 'fixture must omit the execution block');
+    const result = run(['advance', '--heartbeat', file]);
+    assert.equal(result.code, 2, 'missing execution block should exit 2, not the boundary exit 1');
+    assert.ok(!result.stderr.includes('iteration_limit_reached'),
+      'missing-execution-block error must be distinct from the boundary message');
+    pass('heartbeat.json with no execution block exits 2 with a message distinct from the boundary');
+  }
+
+  // --- (5b) an unwritable target on the write path also maps to exit 2, not exit 1.
+  {
+    const badDir = path.join(tmpDir, 'immutable-write-target');
+    fs.mkdirSync(badDir);
+    const file = writeHeartbeat(badDir, { max_iterations: 5, current_iteration: 1 });
+    let guardAvailable = true;
+    try {
+      execFileSync('chattr', ['+i', badDir], { stdio: 'ignore' });
+    } catch (error) {
+      guardAvailable = false;
+    }
+    if (guardAvailable) {
+      const before = readFile(file);
+      const result = run(['advance', '--heartbeat', file]);
+      execFileSync('chattr', ['-i', badDir], { stdio: 'ignore' });
+      assert.equal(result.code, 2, 'a write failure on advance must map to exit 2, not exit 1');
+      assert.equal(readFile(file), before, 'file must be unchanged when the write fails');
+      pass('a write failure on advance (unwritable target) exits 2, distinct from the exit-1 boundary meaning');
+    } else {
+      console.log('SKIP write-failure exit-code test (chattr not available in this sandbox)');
+    }
+  }
+
+  // --- (6) usage errors: no command, unrecognized command, both exit 2.
+  {
+    const noCmd = run([]);
+    assert.equal(noCmd.code, 2, 'missing command should exit 2');
+    const badCmd = run(['bogus']);
+    assert.equal(badCmd.code, 2, 'unrecognized command should exit 2');
+    pass('usage errors (missing/unrecognized command) exit 2');
+  }
+
+  console.log(`\n${passCount} assertions passed. 0 failed.`);
+  process.exit(0);
+} finally {
+  fs.rmSync(tmpDir, { recursive: true, force: true });
+}
