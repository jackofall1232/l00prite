@@ -0,0 +1,337 @@
+#!/usr/bin/env node
+'use strict';
+
+/**
+ * execution-harness.js — mechanical enforcement of exactly ONE Execution Mode run
+ * boundary: `iteration_limit_reached`.
+ *
+ * Scope (deliberately narrow — see CLAUDE.md section 2 and templates/l00prite/prompts/
+ * execute-loop.md "Run boundaries" list): l00prite's execute-loop protocol defines nine
+ * run boundaries. Eight of them (`definition_of_done_met`, `human_review_gate`,
+ * `destructive_operation_required`, `ambiguous_requirements`, `unfixable_failing_tests`,
+ * `missing_secrets_or_credentials`, `lock_lease_conflict`, `stop_signal`) require judgment
+ * calls this script cannot make and remain protocol-only: validator-checked prompt text
+ * that an agent is asked (not forced) to follow. This script does NOT attempt any of them.
+ *
+ * This script mechanically enforces only `iteration_limit_reached`: it reads
+ * execution.current_iteration and execution.max_iterations from a heartbeat.json file,
+ * and its `advance` subcommand refuses — in its own control flow, via a plain `if` that
+ * runs unconditionally before any write — to increment the counter once
+ * current_iteration >= max_iterations, no matter what a prompt or agent asks it to do.
+ * There is no flag, subcommand, or code path anywhere in this file that assigns to
+ * execution.max_iterations (or reads it for anything other than the `>=` comparison) —
+ * "raise the limit" is not a bug this script avoids, it is an operation the script has no
+ * way to perform. This mirrors the self-modification guard already documented in
+ * CLAUDE.md section 2 and execute-loop.md's "No self-modification" rule.
+ *
+ * Honest limitation: this guarantee holds only for callers that route iteration
+ * advancement through this script and treat a non-zero exit as a hard stop. It cannot
+ * stop a caller that bypasses the script entirely — hand-editing heartbeat.json directly,
+ * or editing this script itself. No userland script in a filesystem-writable agent
+ * environment can prevent that. This script also does not detect a hand-raised
+ * max_iterations; it simply re-serializes whatever value it reads.
+ *
+ * Dependency-free: only Node's built-in `fs` and `path` modules, matching the
+ * conservatism of scripts/validate-l00prite.js.
+ *
+ * Usage:
+ *   node scripts/execution-harness.js status  [--heartbeat <path>] [--json]
+ *   node scripts/execution-harness.js advance [--heartbeat <path>] [--json]
+ *
+ * Exit codes:
+ *   0 = success (status report, or advance incremented and persisted)
+ *   1 = the iteration_limit_reached boundary fired; advance refused; file left untouched
+ *   2 = usage or data error (bad flags, unreadable/unparseable file, missing/malformed
+ *       execution block, or a write failure) — NOT a run boundary. Kept distinct from
+ *       exit 1 so a wrapping shell loop (e.g. `while node scripts/execution-harness.js
+ *       advance; do ...; done`) can tell "the run legitimately hit its cap" apart from
+ *       "the tool was misconfigured."
+ *
+ * `status` is read-only and always exits 0 on a successful read, even when the cap has
+ * already been reached (it reports `limit_reached: true` rather than refusing) — only
+ * `advance`'s non-zero exit is the enforcement signal. Do not gate a loop on `status`.
+ *
+ * This script does not check or acquire `.l00prite/lock.json`. A caller wiring this into
+ * execute-loop's iteration protocol is expected to already hold the run lock per
+ * LOCKING.md before calling `advance`; this script only touches heartbeat.json itself.
+ */
+
+const fs = require('fs');
+const path = require('path');
+
+const BOUNDARY_ID = 'iteration_limit_reached';
+
+const HELP_TEXT = `execution-harness.js — mechanical enforcement of the iteration_limit_reached run boundary only.
+
+Usage:
+  node scripts/execution-harness.js status  [--heartbeat <path>] [--json]
+  node scripts/execution-harness.js advance [--heartbeat <path>] [--json]
+  node scripts/execution-harness.js --help
+
+Commands:
+  status   Read-only. Reports execution.current_iteration, execution.max_iterations,
+           remaining, and whether the iteration_limit_reached boundary has been reached.
+           Never writes. Exits 0 on a successful read (even at the cap) or 2 on error.
+  advance  Enforcement command. Increments execution.current_iteration by exactly one and
+           persists it — UNLESS current_iteration >= max_iterations, in which case it
+           refuses: exits 1, prints a message naming the iteration_limit_reached boundary,
+           and writes nothing.
+
+Options:
+  --heartbeat <path>   Path to a heartbeat.json file. Defaults to this repo's own
+                        .l00prite/heartbeat.json (resolved relative to this script, not
+                        the caller's working directory).
+  --json                Emit a single JSON object instead of text. Exit codes are
+                        unchanged, so callers can branch on the exit code without
+                        parsing JSON.
+  -h, --help            Show this help text and exit 0.
+
+Exit codes:
+  0   success (status report, or advance incremented and persisted)
+  1   iteration_limit_reached boundary fired; advance refused; file untouched
+  2   usage or data error (bad flags, unreadable/unparseable file, missing or malformed
+      execution block, or a write failure) — not a run boundary
+
+Scope: this script enforces ONLY iteration_limit_reached. The other eight Execution Mode
+run boundaries (definition_of_done_met, human_review_gate, destructive_operation_required,
+ambiguous_requirements, unfixable_failing_tests, missing_secrets_or_credentials,
+lock_lease_conflict, stop_signal) are not implemented here and remain protocol-only
+(validator-checked prompt text in templates/l00prite/prompts/execute-loop.md).
+
+Self-modification guard: this script contains no code path that writes
+execution.max_iterations. It cannot raise its own limit.
+`;
+
+function defaultHeartbeatPath() {
+  return path.resolve(__dirname, '..', '.l00prite', 'heartbeat.json');
+}
+
+function parseArgs(argv) {
+  const args = {
+    command: null,
+    heartbeatPath: null,
+    json: false,
+    help: false
+  };
+  const rest = argv.slice(2);
+  for (let i = 0; i < rest.length; i++) {
+    const arg = rest[i];
+    if (arg === '-h' || arg === '--help') {
+      args.help = true;
+    } else if (arg === '--json') {
+      args.json = true;
+    } else if (arg === '--heartbeat') {
+      const value = rest[i + 1];
+      if (value === undefined) {
+        throw new UsageError('--heartbeat requires a path argument');
+      }
+      args.heartbeatPath = value;
+      i++;
+    } else if (arg.startsWith('--heartbeat=')) {
+      args.heartbeatPath = arg.slice('--heartbeat='.length);
+    } else if (arg === 'status' || arg === 'advance') {
+      if (args.command !== null) {
+        throw new UsageError(`unexpected extra command "${arg}" (already have "${args.command}")`);
+      }
+      args.command = arg;
+    } else {
+      throw new UsageError(`unrecognized argument "${arg}"`);
+    }
+  }
+  return args;
+}
+
+class UsageError extends Error {}
+class DataError extends Error {}
+class BoundaryError extends Error {
+  constructor(message, details) {
+    super(message);
+    this.details = details;
+  }
+}
+
+function readHeartbeat(heartbeatPath) {
+  let raw;
+  try {
+    raw = fs.readFileSync(heartbeatPath, 'utf8');
+  } catch (error) {
+    throw new DataError(`could not read heartbeat file at ${heartbeatPath}: ${error.message}`);
+  }
+  let data;
+  try {
+    data = JSON.parse(raw);
+  } catch (error) {
+    throw new DataError(`could not parse heartbeat file at ${heartbeatPath} as JSON: ${error.message}`);
+  }
+  return data;
+}
+
+function validateExecutionBlock(data, heartbeatPath) {
+  if (!data || typeof data !== 'object' || Array.isArray(data)) {
+    throw new DataError(`heartbeat file at ${heartbeatPath} does not contain a JSON object`);
+  }
+  if (!data.execution || typeof data.execution !== 'object' || Array.isArray(data.execution)) {
+    // Matches execute-loop.md: "A missing execution block always means execution is
+    // disabled." This is a schema/config error, not the iteration_limit_reached boundary.
+    throw new DataError(
+      `heartbeat file at ${heartbeatPath} has no "execution" block. Per execute-loop.md, ` +
+      `a missing execution block always means execution is disabled — this script has ` +
+      `nothing to enforce until the schema is migrated (see execute-loop.md step 4).`
+    );
+  }
+  const execution = data.execution;
+  const current = execution.current_iteration;
+  const max = execution.max_iterations;
+  if (!Number.isInteger(current) || current < 0) {
+    throw new DataError(
+      `heartbeat file at ${heartbeatPath}: execution.current_iteration must be an integer >= 0 (got ${JSON.stringify(current)})`
+    );
+  }
+  if (!Number.isInteger(max) || max < 1) {
+    throw new DataError(
+      `heartbeat file at ${heartbeatPath}: execution.max_iterations must be an integer >= 1 (got ${JSON.stringify(max)})`
+    );
+  }
+  return { current, max };
+}
+
+function writeHeartbeatAtomic(heartbeatPath, data) {
+  const serialized = JSON.stringify(data, null, 2) + '\n';
+  const dir = path.dirname(heartbeatPath);
+  const tmpPath = path.join(dir, `.${path.basename(heartbeatPath)}.tmp-${process.pid}-${Date.now()}`);
+  try {
+    fs.writeFileSync(tmpPath, serialized, 'utf8');
+    fs.renameSync(tmpPath, heartbeatPath);
+  } catch (error) {
+    try {
+      if (fs.existsSync(tmpPath)) fs.unlinkSync(tmpPath);
+    } catch (cleanupError) {
+      // best-effort cleanup only; surface the original error
+    }
+    throw new DataError(`failed to write heartbeat file at ${heartbeatPath}: ${error.message}`);
+  }
+}
+
+function runStatus(heartbeatPath, json) {
+  const data = readHeartbeat(heartbeatPath);
+  const { current, max } = validateExecutionBlock(data, heartbeatPath);
+  const remaining = max - current;
+  const limitReached = current >= max;
+  if (json) {
+    process.stdout.write(JSON.stringify({
+      ok: true,
+      command: 'status',
+      heartbeat_path: heartbeatPath,
+      current_iteration: current,
+      max_iterations: max,
+      remaining,
+      limit_reached: limitReached
+    }, null, 2) + '\n');
+  } else {
+    process.stdout.write(
+      `execution.current_iteration=${current} execution.max_iterations=${max} remaining=${remaining} limit_reached=${limitReached}\n`
+    );
+  }
+  return 0;
+}
+
+function runAdvance(heartbeatPath, json) {
+  const data = readHeartbeat(heartbeatPath);
+  const { current, max } = validateExecutionBlock(data, heartbeatPath);
+
+  // --- Enforcement: this `if` is the entire mechanism. It runs unconditionally, before
+  // any write, for every invocation of `advance`. There is no flag or argument that skips
+  // it, and no path below it that touches execution.max_iterations.
+  if (current >= max) {
+    const message =
+      `${BOUNDARY_ID}: execution.current_iteration (${current}) has reached ` +
+      `execution.max_iterations (${max}). Refusing to advance. Per execute-loop.md, the ` +
+      `run must stop at this boundary. execution.current_iteration was NOT modified.`;
+    if (json) {
+      process.stderr.write(JSON.stringify({
+        ok: false,
+        command: 'advance',
+        boundary: BOUNDARY_ID,
+        heartbeat_path: heartbeatPath,
+        current_iteration: current,
+        max_iterations: max,
+        message
+      }, null, 2) + '\n');
+    } else {
+      process.stderr.write(`REFUSED [${BOUNDARY_ID}] ${message}\n`);
+    }
+    return 1;
+  }
+
+  const next = current + 1;
+  data.execution.current_iteration = next;
+  writeHeartbeatAtomic(heartbeatPath, data);
+
+  if (json) {
+    process.stdout.write(JSON.stringify({
+      ok: true,
+      command: 'advance',
+      heartbeat_path: heartbeatPath,
+      previous_iteration: current,
+      current_iteration: next,
+      max_iterations: max
+    }, null, 2) + '\n');
+  } else {
+    process.stdout.write(
+      `advanced execution.current_iteration ${current} -> ${next} (execution.max_iterations=${max} unchanged)\n`
+    );
+  }
+  return 0;
+}
+
+function main() {
+  let args;
+  try {
+    args = parseArgs(process.argv);
+  } catch (error) {
+    process.stderr.write(`usage error: ${error.message}\n\n${HELP_TEXT}`);
+    process.exit(2);
+    return;
+  }
+
+  if (args.help) {
+    process.stdout.write(HELP_TEXT);
+    process.exit(0);
+    return;
+  }
+
+  if (!args.command) {
+    process.stderr.write(`usage error: missing command (expected "status" or "advance")\n\n${HELP_TEXT}`);
+    process.exit(2);
+    return;
+  }
+
+  const heartbeatPath = args.heartbeatPath
+    ? path.resolve(args.heartbeatPath)
+    : defaultHeartbeatPath();
+
+  try {
+    let code;
+    if (args.command === 'status') {
+      code = runStatus(heartbeatPath, args.json);
+    } else {
+      code = runAdvance(heartbeatPath, args.json);
+    }
+    process.exit(code);
+  } catch (error) {
+    if (error instanceof DataError) {
+      if (args.json) {
+        process.stderr.write(JSON.stringify({ ok: false, error: error.message }, null, 2) + '\n');
+      } else {
+        process.stderr.write(`error: ${error.message}\n`);
+      }
+      process.exit(2);
+      return;
+    }
+    // Unexpected error: still map to exit 2, never let it collide with exit 1's meaning.
+    process.stderr.write(`unexpected error: ${error && error.stack ? error.stack : error}\n`);
+    process.exit(2);
+  }
+}
+
+main();
