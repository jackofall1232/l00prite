+  check(hb2.execution.current_iteration === 1 && hb2.execution.current_iteration < hb2.execution.max_iterations, 'scenario 1: Agent B finished within its OWN fresh iteration budget (1 < max 2) — it re-armed rather than inheriting/extending Agent A\'s exhausted run');
