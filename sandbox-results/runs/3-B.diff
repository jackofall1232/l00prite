+// ============================================================================
+// Scenario 3: crashed-mid-run fixture — a persisted execution.enabled:true /
+// preflight_confirmed:true does NOT authorize a fresh no-confirm agent to
+// iterate; stale-run recovery still runs and is logged.
+// ============================================================================
+
+function scenario3() {
+  console.log('\n--- Scenario 3: crashed mid-run — persisted flags never authorize; stale-run recovery ---');
+  const units = [{ id: 'unit-1', text: 'create work/unit-1.txt containing "unit-1 done"' }];
+  const past = new Date(Date.now() - 3600000).toISOString();
+  const sandbox = buildSandbox({
+    units,
+    maxIterations: 5,
+    humanReviewGates: [],
+    heartbeatOverrides: {
+      execution: {
+        enabled: true, // stale — the crashed run left this armed
+        preflight_confirmed: true,
+        preflight_confirmed_at: past,
+        preflight_confirmed_by: 'agent-a-crashed',
+        current_iteration: 1
+      },
+      should_continue: true
+    },
+    stateOverrides: { execution_active: true, active_agent: 'agent-a-crashed' },
+    lockOverrides: {
+      lock_id: 'lock-crashed-run',
+      owner_agent: 'agent-a-crashed',
+      owner_session: 'session-a-crashed',
+      acquired_at: past,
+      expires_at: past, // in the past
+      purpose: 'execute-loop run',
+      status: 'expired'
+    }
+  });
+
+  const before = snapshot(sandbox);
+
+  // A fresh agent, NO --confirm, discovers the crashed run.
+  const r = spawnAgentTurn(sandbox, { agentId: 'agent-b-recovery', agentSession: 'session-b-recovery' });
+  check(r.status === 0, 'scenario 3: recovery turn (no confirm) exits 0');
+  check(r.result && r.result.boundary === 'preflight_not_confirmed', 'scenario 3: without --confirm, the agent refuses to iterate even though heartbeat.execution.enabled/preflight_confirmed were persisted as true');
+  check(r.result && r.result.recoveredStaleRun === true, 'scenario 3: the agent detects and performs stale-run recovery');
+
+  const after = snapshot(sandbox);
+  const state2 = readJSON(path.join(sandbox, '.l00prite/state.json'));
+  const hb2 = readJSON(path.join(sandbox, '.l00prite/heartbeat.json'));
+  const lock2 = readJSON(path.join(sandbox, '.l00prite/lock.json'));
+  const todos2 = parseTodos(readText(path.join(sandbox, '.l00prite/todos.md')));
+  const entries = ledgerEntries(sandbox);
+
+  check(state2.execution_active === false, 'scenario 3: state.execution_active flipped from true to false by stale-run recovery');
+  check(lock2.status === 'released', 'scenario 3: lock.json is released at rest after recovery (never held while awaiting confirmation)');
+  check(entries.length === 1 && entries[0].type === 'stale-lock-recovery', 'scenario 3: exactly one ledger entry was written, and it is a stale-lock-recovery entry (no iteration entries — no work was done)');
+  check(entries[0].fields.reclaimed_lock_id === 'lock-crashed-run', 'scenario 3: the reclamation entry names the crashed run\'s prior lock_id');
+  check(entries[0].fields.prior_owner_agent === 'agent-a-crashed', 'scenario 3: the reclamation entry names the prior owner agent');
+  check(entries[0].fields.reason.includes('expired'), 'scenario 3: the reclamation entry records why the lock was judged stale (expired)');
