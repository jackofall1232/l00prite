+// ============================================================================
+// CLI hygiene: the agent-turn subprocess is progress-blind — it rejects any
+// flag outside the fixed generic set, so a scenario cannot smuggle progress
+// hints (e.g. "start at unit-3") through the CLI.
+// ============================================================================
+
+function scenarioCliHygiene() {
+  console.log('\n--- CLI hygiene: unrecognized flags are rejected (progress-blindness guard) ---');
+  const sandbox = buildSandbox({ units: [{ id: 'unit-1', text: 'create work/unit-1.txt containing "unit-1 done"' }], maxIterations: 5 });
+  const r = spawnAgentTurn(sandbox, { agentId: 'a', agentSession: 's', confirm: 'EXECUTE', extraFlag: '--scenario-hint=unit-3' });
+  check(r.status !== 0, 'CLI hygiene: an unrecognized flag (e.g. a smuggled scenario hint) makes the agent-turn subprocess exit non-zero rather than silently accepting it');
+  check(/unrecognized flag/.test(r.stderr || ''), 'CLI hygiene: the rejection names itself as an unrecognized flag');
+}
