+#!/usr/bin/env node
+/**
+ * test-cross-agent-handoff.js
+ * ----------------------------------------------------------------------------
+ * SCOPE (read this before trusting a green run)
+ * ----------------------------------------------------------------------------
+ * This script mechanically proves that the .l00prite/ FILE CONTRACT — the
+ * schema and update rules templates/l00prite/prompts/execute-loop.md specifies
+ * for heartbeat.json / state.json / lock.json / todos.md / ledger.md — is
+ * sufficient for a second, completely independent OS process (standing in for
+ * a different agent vendor) to resume a mid-run boundary stop without redoing
+ * finished work and without silently walking past the boundary the first
+ * process stopped at.
+ *
+ * It does NOT prove that a real vendor LLM (Claude, Codex, Gemini, Copilot,
+ * ...) actually reads and faithfully follows execute-loop.md's prose. Nothing
+ * here invokes a language model. Each "agent turn" below is a small,
+ * deterministic, hand-coded subset of execute-loop.md's rules operating on
+ * trivial toy units (write a fixed string to a fixed file) specifically so
+ * this test never needs an LLM and stays fully reproducible in CI. The
+ * human-executed, real-vendor counterpart to this script is
+ * docs/cross-agent-compat-test.md — run this script first (fast, mechanical);
+ * run that document when you have time to spend a human operator on real
+ * vendor tools.
+ *
+ * "Two agents sharing only files" is implemented as two genuinely separate OS
+ * processes: the orchestrator (this file, run with no arguments) spawns this
+ * same file again via child_process.spawnSync(process.execPath, ...) with
+ * `--agent-turn`, once per simulated agent turn. Each spawned process is
+ * scenario-agnostic and progress-blind: it accepts only
+ * --sandbox / --agent-id / --agent-session / --confirm / --approve-gate /
+ * --ignore-progress and learns everything about the project by reading the
+ * sandbox's .l00prite/*.md / *.json and work/* files — the exact file set the
+ * protocol defines as shared memory. It never receives a "start at unit-3"
+ * style hint, and rejects any unrecognized flag (see parseAgentArgs) so a
+ * scenario cannot smuggle progress state in through the CLI. Every assertion
+ * below re-reads the sandbox from disk after each subprocess exits; nothing
+ * is taken on the subprocess's self-reported word.
+ *
+ * KNOWN, DELIBERATE SIMPLIFICATIONS (so nothing here is overclaimed):
+ *  - The sandbox's todos.md is a flat checklist (no Next/Later/Done sections)
+ *    and its ledger.md entries are a simplified, machine-parseable subset of
+ *    the real Entry Template's field vocabulary (goal/command/exit_code/
+ *    summary/timestamp/lock) — not the full prose template. The real
+ *    templates/l00prite/ledger.md template and its Entry Template fields are
+ *    validated separately by scripts/validate-l00prite.js.
+ *  - Only one human_review_gate trigger is exercised: a heartbeat.json
+ *    human_review_gates entry whose file-path token appears in a todos.md
+ *    unit's own text (deterministic, no LLM judgment required). The other
+ *    listed triggers (ambiguous scope, a post-confirmation event, a required
+ *    protocol-file change) are not simulated here.
+ *  - lock.json ownership cannot be observed *between* turns because
+ *    LOCKING.md rule 5 clears owner_agent/owner_session to null on release —
+ *    this script does not assert on owner_agent at rest. Distinct ownership
+ *    across agents is instead proven via the append-only ledger's per-entry
+ *    "lock:" field, which each agent turn writes while it holds the lock.
+ *
+ * Run: node scripts/test-cross-agent-handoff.js
+ * Prints PASS/FAIL lines in the same style as scripts/validate-l00prite.js.
+ * Exits 0 iff every check passed. On any failure the sandbox directories are
+ * left on disk and their paths are printed; on success they are removed.
+ * ----------------------------------------------------------------------------
+ */
+'use strict';
+
+const fs = require('fs');
+const path = require('path');
+const os = require('os');
+const child_process = require('child_process');
+
+const REPO_ROOT = path.resolve(__dirname, '..');
+const CANONICAL_EXECUTE_LOOP = path.join(REPO_ROOT, 'templates/l00prite/prompts/execute-loop.md');
+
+const RUN_BOUNDARIES = [
+  'definition_of_done_met',
+  'iteration_limit_reached',
+  'human_review_gate',
+  'destructive_operation_required',
+  'ambiguous_requirements',
+  'unfixable_failing_tests',
+  'missing_secrets_or_credentials',
+  'lock_lease_conflict',
+  'stop_signal'
+];
+
+// ============================================================================
+// Small pure helpers (also used, in-process, by the direct meta-tests below —
+// these are logic tests, not simulated "agent turns", so calling them
+// in-process does not weaken the cross-process claim above).
+// ============================================================================
+
+function nowIso() {
+  return new Date().toISOString().replace(/\.\d+Z$/, 'Z');
+}
+
+function extractPathTokens(text) {
+  // A "path token" looks like a filename or relative path with an extension,
+  // e.g. "scripts/validate-l00prite.js". Deliberately stricter than a loose
+  // substring match so an incidental shared word can't cause a false gate.
+  return text.match(/[\w.\-/]+\.[A-Za-z0-9]+/g) || [];
+}
+
+function unitTriggersGate(unitText, gates) {
+  for (const gate of gates || []) {
+    for (const token of extractPathTokens(gate)) {
+      if (unitText.includes(token)) return gate;
+    }
+  }
+  return null;
+}
+
+function parseTodos(text) {
+  const lines = text.split('\n');
+  const units = [];
+  const re = /^- \[( |x)\] (unit-\d+): (.*)$/;
+  for (const line of lines) {
+    const m = line.match(re);
+    if (m) units.push({ id: m[2], checked: m[1] === 'x', text: m[3], raw: line });
+  }
+  return units;
+}
+
+function setTodoChecked(text, unitId) {
+  const re = new RegExp(`^- \\[ \\] (${unitId}):`, 'm');
+  if (!re.test(text)) {
+    throw new Error(`setTodoChecked: unit ${unitId} not found unchecked in todos.md`);
+  }
+  return text.replace(re, '- [x] $1:');
+}
+
+function parseUnitAction(unitText) {
+  const m = unitText.match(/create work\/(\S+) containing "([^"]+)"/);
+  if (!m) throw new Error(`parseUnitAction: could not parse action from unit text: ${unitText}`);
+  return { file: m[1], content: m[2] };
+}
+
+function parseLedgerEntries(text) {
+  const blocks = text.split(/\n(?=### Entry )/).filter((b) => b.trim().startsWith('### Entry'));
+  return blocks.map((block) => {
+    const header = block.match(/^### Entry (\S+) — agent=(\S+) session=(\S+) type=(\S+)/);
+    const fields = {};
+    for (const line of block.split('\n')) {
+      const m = line.match(/^- ([a-z_]+): (.*)$/);
+      if (m) fields[m[1]] = m[2];
+    }
+    return {
+      timestamp: header ? header[1] : null,
+      agent: header ? header[2] : null,
+      session: header ? header[3] : null,
+      type: header ? header[4] : null,
+      fields,
+      raw: block
+    };
+  });
+}
+
+function formatLedgerEntry({ agentId, agentSession, type, fields }) {
+  const lines = [`### Entry ${nowIso()} — agent=${agentId} session=${agentSession} type=${type}`];
+  for (const [k, v] of Object.entries(fields)) {
+    lines.push(`- ${k}: ${v}`);
+  }
+  return lines.join('\n') + '\n';
+}
+
+function appendLedgerEntry(sandbox, entry) {
+  const p = path.join(sandbox, '.l00prite/ledger.md');
+  const existing = fs.readFileSync(p, 'utf8');
+  fs.writeFileSync(p, existing.replace(/\n*$/, '\n\n') + formatLedgerEntry(entry));
+}
+
+// ============================================================================
+// Filesystem helpers
+// ============================================================================
+
+function readJSON(p) {
+  return JSON.parse(fs.readFileSync(p, 'utf8'));
+}
+function writeJSON(p, obj) {
+  fs.writeFileSync(p, JSON.stringify(obj, null, 2) + '\n');
+}
+function readText(p) {
+  return fs.readFileSync(p, 'utf8');
+}
+function writeText(p, s) {
+  fs.writeFileSync(p, s);
+}
+
+function walkFiles(dir) {
+  const out = [];
+  if (!fs.existsSync(dir)) return out;
+  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+    const full = path.join(dir, entry.name);
+    if (entry.isDirectory()) out.push(...walkFiles(full));
+    else out.push(full);
+  }
+  return out;
+}
+
+function snapshot(sandbox) {
+  const map = {};
+  for (const full of walkFiles(sandbox)) {
+    map[path.relative(sandbox, full)] = fs.readFileSync(full, 'utf8');
+  }
+  return map;
+}
+
+function diffSnapshots(before, after) {
+  const keys = new Set([...Object.keys(before), ...Object.keys(after)]);
+  const diffs = [];
+  for (const k of keys) {
+    if (before[k] !== after[k]) diffs.push(k);
+  }
+  return diffs;
+}
