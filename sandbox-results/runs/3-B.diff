+  check(todos2.every((u) => !u.checked), 'scenario 3: no todos.md unit was touched');
+  const changedFiles = diffSnapshots(before, after);
+  check(
+    changedFiles.sort().join(',') === ['.l00prite/lock.json', '.l00prite/state.json', '.l00prite/ledger.md'].sort().join(','),
+    `scenario 3: only the three files recovery is specified to touch actually changed (changed: ${changedFiles.join(', ')})`
+  );
+
+  // Now a genuinely confirmed run on the recovered sandbox proceeds normally,
+  // with a fresh iteration budget (proving the project is not permanently
+  // stuck after recovery).
+  const r2 = spawnAgentTurn(sandbox, { agentId: 'agent-b-recovery', agentSession: 'session-b-recovery-2', confirm: 'EXECUTE' });
+  check(r2.status === 0, 'scenario 3: follow-up confirmed run exits 0');
+  check(r2.result && r2.result.boundary === 'definition_of_done_met', 'scenario 3: the follow-up confirmed run completes the single remaining unit');
+  const hb3 = readJSON(path.join(sandbox, '.l00prite/heartbeat.json'));
+  check(hb3.execution.current_iteration === 1, 'scenario 3: the follow-up run got its own fresh iteration budget (reset to 0, then incremented once) rather than continuing the crashed run\'s stale counter');
+
+}
