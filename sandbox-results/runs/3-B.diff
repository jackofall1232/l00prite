+  const b2 = spawnAgentTurn(sandbox, { agentId: 'agent-b2-gemini', agentSession: 'session-b2', confirm: 'EXECUTE', approveGate: 'unit-3' });
+  check(b2.status === 0, 'scenario 2 (B2, approved): turn exits 0');
+  check(b2.result && b2.result.boundary === 'definition_of_done_met', 'scenario 2 (B2, approved): reaches definition_of_done_met after the approved gate');
+  check(b2.result && b2.result.iterationsCompleted === 2 && b2.result.unitsCompleted.join(',') === 'unit-3,unit-4', 'scenario 2 (B2, approved): completed exactly unit-3 then unit-4, in order, nothing redone');
+
+  const todos2 = parseTodos(readText(path.join(sandbox, '.l00prite/todos.md')));
+  check(todos2.every((u) => u.checked), 'scenario 2 checkpoint 2: every unit is checked off');
+  check(readText(path.join(sandbox, 'work/unit-3.txt')) === 'unit-3 done', 'scenario 2 checkpoint 2: work/unit-3.txt has the right content');
+  check(readText(path.join(sandbox, 'work/unit-4.txt')) === 'unit-4 done', 'scenario 2 checkpoint 2: work/unit-4.txt has the right content');
+  check(findRedoViolations(sandbox).length === 0, 'scenario 2 checkpoint 2: no unit was executed more than once across A and B2');
+  const ownersA = lockOwnersUsedBy(sandbox, 'agent-a-claude');
+  const ownersB2 = lockOwnersUsedBy(sandbox, 'agent-b2-gemini');
+  check([...ownersA].every((o) => !ownersB2.has(o)), 'scenario 2: Agent A and Agent B2 have disjoint ledger-recorded lock owners');
+
+}
