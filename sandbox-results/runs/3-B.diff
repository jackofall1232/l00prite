+// ============================================================================
+// Main
+// ============================================================================
+
+function main() {
+  const argv = process.argv.slice(2);
+  if (argv.includes('--agent-turn')) {
+    const rest = argv.filter((a) => a !== '--agent-turn');
+    let args;
+    try {
+      args = parseAgentArgs(rest);
+    } catch (e) {
+      console.error(`agent-turn argument error: ${e.message}`);
+      process.exit(2);
+    }
+    try {
+      runAgentTurn(args);
+      process.exit(0);
+    } catch (e) {
+      console.error(`agent-turn runtime error: ${e.stack || e.message}`);
+      process.exit(1);
+    }
+  }
+
+  console.log('l00prite cross-agent handoff test (file-contract / state-machine level)');
+  console.log(`canonical execute-loop.md: ${CANONICAL_EXECUTE_LOOP}`);
+
+  try {
+    scenario1();
+    scenario2();
+    scenario3();
+    scenario4();
+    scenarioCliHygiene();
+  } catch (e) {
+    console.error(`FAIL uncaught exception during test run: ${e.stack || e.message}`);
+    failed = true;
+  }
+
+  // Cleanup is centralized here: every sandbox created by buildSandbox() or
+  // copySandbox() is tracked in CREATED_SANDBOXES. If everything passed,
+  // remove them all. If anything failed, leave them all on disk and print
+  // their paths for inspection.
+  console.log('');
+  if (failed) {
+    console.error('RESULT: FAIL — see FAIL lines above.');
+    console.error('Sandboxes left on disk for inspection:');
+    for (const d of CREATED_SANDBOXES) console.error(`  ${d}`);
+    process.exit(1);
+  } else {
+    for (const d of CREATED_SANDBOXES) fs.rmSync(d, { recursive: true, force: true });
+    console.log('RESULT: PASS — all checks passed; sandboxes cleaned up.');
+    process.exit(0);
+  }
+}
+
+if (require.main === module) {
+  main();
+}
