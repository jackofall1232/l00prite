+    { id: 'unit-3', text: 'create work/unit-3.txt containing "unit-3 done" (touches scripts/validate-l00prite.js)' },
+    { id: 'unit-4', text: 'create work/unit-4.txt containing "unit-4 done"' }
+  ];
+
+  // Direct meta-test of the gate-matching logic itself (in-process, pure
+  // function — not a simulated agent turn) before trusting any subprocess
+  // result that depends on it: positive match for the gated unit, negative
+  // for the three ungated ones.
+  check(unitTriggersGate(units[0].text, [gate]) === null, 'scenario 2 meta-test: gate matcher does NOT fire for unit-1 (negative)');
+  check(unitTriggersGate(units[1].text, [gate]) === null, 'scenario 2 meta-test: gate matcher does NOT fire for unit-2 (negative)');
+  check(unitTriggersGate(units[2].text, [gate]) === gate, 'scenario 2 meta-test: gate matcher DOES fire for unit-3 (positive)');
+  check(unitTriggersGate(units[3].text, [gate]) === null, 'scenario 2 meta-test: gate matcher does NOT fire for unit-4 (negative)');
+
+  const sandbox = buildSandbox({ units, maxIterations: 10, humanReviewGates: [gate] });
+
+  const a = spawnAgentTurn(sandbox, { agentId: 'agent-a-claude', agentSession: 'session-a2', confirm: 'EXECUTE' });
+  check(a.status === 0, 'scenario 2: Agent A turn exits 0');
+  check(a.result && a.result.boundary === 'human_review_gate', 'scenario 2: Agent A stops at human_review_gate');
+  check(a.result && a.result.iterationsCompleted === 2, 'scenario 2: Agent A completed exactly 2 iterations before the gate (unit-1, unit-2)');
+
+  // Checkpoint 1.
+  const hb1 = readJSON(path.join(sandbox, '.l00prite/heartbeat.json'));
+  const todos1 = parseTodos(readText(path.join(sandbox, '.l00prite/todos.md')));
+  check(hb1.execution.last_run_boundary === 'human_review_gate', 'scenario 2 checkpoint 1: heartbeat execution.last_run_boundary === human_review_gate');
+  check(hb1.execution.current_iteration === 2, 'scenario 2 checkpoint 1: heartbeat execution.current_iteration === 2 (well under max_iterations=10 — this is genuinely the gate, not the iteration cap)');
+  check(todos1.find((u) => u.id === 'unit-3').checked === false, 'scenario 2 checkpoint 1: gated unit-3 is untouched');
+  check(todos1.find((u) => u.id === 'unit-4').checked === false, 'scenario 2 checkpoint 1: unit-4 (after the gate) is untouched');
+  check(!fs.existsSync(path.join(sandbox, 'work/unit-3.txt')), 'scenario 2 checkpoint 1: work/unit-3.txt does not exist');
+  check(!fs.existsSync(path.join(sandbox, 'work/unit-4.txt')), 'scenario 2 checkpoint 1: work/unit-4.txt does not exist');
+  check(ledgerEntries(sandbox).filter((e) => e.fields.unit === 'unit-3' || e.fields.unit === 'unit-4').length === 0, 'scenario 2 checkpoint 1: no ledger entry mentions unit-3 or unit-4');
+
+  // --- B1: a fresh session/agent, --confirm only, NO --approve-gate. It must
+  // re-arm (fresh budget), re-derive the SAME gate from the files, and stop
+  // again at human_review_gate WITHOUT changing anything — proving a
+  // different vendor cannot silently walk past a boundary it did not
+  // personally set. Run on an isolated copy so it doesn't consume the
+  // fixture Agent B2 (below) needs.
+  const b1sandbox = copySandbox(sandbox);
+  const beforeB1 = snapshot(b1sandbox);
+  const b1 = spawnAgentTurn(b1sandbox, { agentId: 'agent-b1-gemini', agentSession: 'session-b1', confirm: 'EXECUTE' });
+  check(b1.status === 0, 'scenario 2 (B1, no approval): turn exits 0');
+  check(b1.result && b1.result.boundary === 'human_review_gate', 'scenario 2 (B1, no approval): a fresh confirmed session hits the SAME human_review_gate again rather than bypassing it');
+  const afterB1 = snapshot(b1sandbox);
+  const workDiffsB1 = Object.keys(afterB1).filter((k) => k.startsWith('work/') && afterB1[k] !== beforeB1[k]);
+  check(workDiffsB1.length === 0, 'scenario 2 (B1, no approval): no new/changed work/ files — the gated unit was not silently executed');
+  const todosB1 = parseTodos(readText(path.join(b1sandbox, '.l00prite/todos.md')));
+  check(todosB1.find((u) => u.id === 'unit-3').checked === false, 'scenario 2 (B1, no approval): unit-3 still unchecked after the fresh session\'s attempt');
+  const hbB1 = readJSON(path.join(b1sandbox, '.l00prite/heartbeat.json'));
+  check(hbB1.execution.last_run_boundary === 'human_review_gate', 'scenario 2 (B1, no approval): heartbeat again records human_review_gate as the stop reason');
+
+  // --- B2: --confirm plus --approve-gate=unit-3 (standing in for the human
+  // review actually happening) proceeds through unit-3 and unit-4 to
