+  if (confirm) flags.push(`--confirm=${confirm}`);
+  if (approveGate) flags.push(`--approve-gate=${approveGate}`);
+  if (ignoreProgress) flags.push('--ignore-progress');
+  if (extraFlag) flags.push(extraFlag);
