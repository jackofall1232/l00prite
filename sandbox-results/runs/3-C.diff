+
+// ---------------------------------------------------------------------------
+// Orchestrator: fresh fixture copy -> Agent A (child process) -> checkpoint asserts ->
+// Agent B or Agent B-violating (child process) -> checkpoint asserts -> summary.
+// ---------------------------------------------------------------------------
+function assertList() {
+  const results = [];
+  return {
+    check(cond, label) {
+      results.push({ pass: !!cond, label });
+      console.log(`${cond ? 'PASS' : 'FAIL'} ${label}`);
+    },
+    results,
+  };
+}
+
+function gitHeadShort() {
+  try {
+    return execFileSync('git', ['rev-parse', '--short', 'HEAD'], { cwd: REPO_ROOT }).toString().trim();
+  } catch (e) {
+    return 'unknown';
+  }
+}
+
+function orchestrate({ violation }) {
+  console.log(`\n=========================================================`);
+  console.log(`Cross-agent Execution Mode compatibility test`);
+  console.log(`repo HEAD: ${gitHeadShort()}   mode: ${violation ? 'VIOLATION (expect FAILs)' : 'compliant (expect all PASS)'}`);
+  console.log(`=========================================================\n`);
+
+  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'l00prite-cross-agent-'));
