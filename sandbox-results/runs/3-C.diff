+    hb.should_continue = true;
+    writeJSON(paths.heartbeat, hb);
+    state.execution_active = true;
+    state.active_agent = agentId;
+    writeJSON(paths.state, state);
+  }
+
+  log('--- ITERATION PROTOCOL ---');
+  let boundary = null;
+  const completedThisRun = [];
+
+  if (violating) {
+    // Deliberately wrong: redo T1 (already done), then bulldoze through the gated T2.
+    log('[VIOLATION] redoing T1 even though todos.md already shows it done.');
+    doWork(dir, 'T1');
+    const v1 = verifyWork(dir, 'T1');
+    completedThisRun.push({ id: 'T1 (REDONE)', verification: v1 });
+    log('[VIOLATION] implementing T2 (GATE: destructive-operation) without any human review.');
+    doWork(dir, 'T2');
+    const v2 = verifyWork(dir, 'T2');
+    markTodoDone(dir, 'T2', agentId);
+    completedThisRun.push({ id: 'T2 (GATE BYPASSED)', verification: v2 });
+    boundary = 'none (violation: ran through a boundary instead of stopping)';
+  } else {
+    while (true) {
+      const next = pickNextTodo(dir);
+      if (!next) { boundary = 'definition_of_done_met'; break; }
+      if (next.gated) {
+        log(`selected unit ${next.id} but it is GATE-tagged — human_review_gate boundary. Stopping before executing it. No new iteration is consumed.`);
+        boundary = 'human_review_gate';
+        break;
+      }
+      log(`iteration ${hb.execution.current_iteration + 1}: executing unit ${next.id}.`);
+      doWork(dir, next.id);
+      const v = verifyWork(dir, next.id);
+      log(`verify: ${v.summary} (exit_code=${v.exit_code})`);
+      if (!v.ok) { boundary = 'unfixable_failing_tests'; break; }
+      markTodoDone(dir, next.id, agentId);
+      completedThisRun.push({ id: next.id, verification: v });
+      hb.execution.current_iteration += 1;
+      writeJSON(paths.heartbeat, hb);
+      if (hb.execution.current_iteration >= hb.execution.max_iterations) {
+        boundary = 'iteration_limit_reached';
+        break;
+      }
+    }
+  }
+
+  log(`--- MODE EXIT: boundary = ${boundary} ---`);
+  appendLedgerEntry(dir, agentId + (violating ? ' [VIOLATING — for selftest only]' : ''), {
+    goal: 'resume widget-cli fixture Execution Mode run from a different vendor (run 2)',
+    decision: violating ? 'VIOLATION SCENARIO: deliberately non-compliant, used only by `selftest` to prove the assertions catch it.' : 'Normal work; fresh confirmed pre-flight, resumed from Agent A\'s file state only.',
+    completedWork: completedThisRun.length ? completedThisRun.map((c) => c.id).join(', ') : 'none (stopped at human_review_gate before executing anything)',
+    changedFiles: completedThisRun.length ? 'widget_cli.txt, .l00prite/todos.md' : 'none',
+    verification: completedThisRun.map((c) => c.verification),
+    failures: 'none',
+    decisions: violating ? 'N/A — violation scenario' : 'T2 remains GATE-tagged and untouched; T1 was not redone.',
+    confidence: 'high — deterministic scripted run',
+    nextAction: violating ? 'n/a' : 'a human resolves the destructive-operation review for T2, then a fresh confirmed run continues with T2 and T3',
+    lock: violating ? 'NOT acquired (violation)' : 'acquired and released this run',
+  });
+  state.execution_active = false;
+  state.execution_stop_reason = boundary;
+  state.last_agent = agentId;
+  state.active_agent = null;
+  state.last_updated = nowISO();
+  state.next_recommended_action = violating ? 'n/a — violation scenario' : 'human resolves T2\'s destructive-operation review, then a fresh execute-loop pre-flight continues';
