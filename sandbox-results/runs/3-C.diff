+  hb.execution.enabled = false;
+  hb.execution.last_run_boundary = boundary;
+  hb.last_run_time = nowISO();
+  hb.pause_reason = violating ? 'violation scenario' : `stopped at ${boundary} (T2 gated; T3 not yet attempted)`;
+  hb.should_continue = false;
