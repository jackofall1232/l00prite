+#!/usr/bin/env node
+'use strict';
+/**
+ * Cross-agent Execution Mode compatibility test.
+ *
+ * Companion to docs/cross-agent-compat-test.md, which this script implements the automated
+ * half of. Full design intent, honesty caveats, and the manual (real two-vendor) protocol
+ * live in that document — read it first if you have not.
+ *
+ * WHAT THIS SCRIPT ACTUALLY PROVES: that the .l00prite/ file-state machine described by
+ * templates/l00prite/prompts/execute-loop.md is mechanically resumable across a simulated
+ * vendor boundary — locking, a fresh iteration budget on re-arming, todo/ledger continuity,
+ * and honest boundary persistence — using two independent OS processes ("Agent A" and
+ * "Agent B") that share NOTHING but the files on disk in a scratch copy of
+ * tests/cross-agent-compat/fixture/.
+ *
+ * WHAT THIS SCRIPT DOES NOT PROVE: that a real LLM-driven agent will choose to follow the
+ * protocol. Agent A and Agent B here are deterministic stand-ins that execute the protocol's
+ * rules exactly as written (including the "wait for explicit human confirmation" step, which
+ * is simulated and loudly labeled as such). That gap is exactly what
+ * docs/cross-agent-compat-test.md's manual protocol is for: running this same fixture with
+ * two real, different-vendor agent sessions and a real human in the loop.
+ *
+ * Usage:
+ *   node scripts/cross-agent-compat-test.js run              # compliant A -> B, expect PASS
+ *   node scripts/cross-agent-compat-test.js run --violation   # A -> non-compliant B, expect
+ *                                                              # the harness to CATCH it
+ *   node scripts/cross-agent-compat-test.js selftest          # runs both of the above and
+ *                                                              # confirms the harness has
+ *                                                              # discriminating power
+ *
+ * Internal (spawned as separate `node` processes by `run`, not meant to be invoked directly
+ * outside a scratch copy of the fixture):
+ *   node scripts/cross-agent-compat-test.js agent-a <dir>
+ *   node scripts/cross-agent-compat-test.js agent-b <dir>
+ *   node scripts/cross-agent-compat-test.js agent-b-violating <dir>
+ */
+const fs = require('fs');
+const path = require('path');
+const os = require('os');
+const { execFileSync } = require('child_process');
+
+const REPO_ROOT = path.resolve(__dirname, '..');
+const FIXTURE_DIR = path.join(REPO_ROOT, 'tests/cross-agent-compat/fixture');
+
+// ---------------------------------------------------------------------------
+// Small file/JSON helpers
+// ---------------------------------------------------------------------------
+function readText(p) { return fs.readFileSync(p, 'utf8'); }
+function writeText(p, s) { fs.writeFileSync(p, s); }
+function readJSON(p) { return JSON.parse(readText(p)); }
+function writeJSON(p, obj) { writeText(p, JSON.stringify(obj, null, 2) + '\n'); }
+// Millisecond precision (not truncated to the second): Agent A and Agent B run as separate
+// child processes milliseconds apart, and several assertions below rely on their
+// preflight_confirmed_at timestamps being genuinely distinct, not just distinct identities.
+function nowISO() { return new Date().toISOString(); }
+
+function copyDirRecursive(src, dest) {
+  fs.mkdirSync(dest, { recursive: true });
+  for (const entry of fs.readdirSync(src, { withFileTypes: true })) {
+    const s = path.join(src, entry.name);
+    const d = path.join(dest, entry.name);
+    if (entry.isDirectory()) copyDirRecursive(s, d);
+    else fs.copyFileSync(s, d);
+  }
+}
+
+const L = (dir) => ({
+  blueprint: path.join(dir, '.l00prite/blueprint.md'),
+  todos: path.join(dir, '.l00prite/todos.md'),
+  ledger: path.join(dir, '.l00prite/ledger.md'),
+  heartbeat: path.join(dir, '.l00prite/heartbeat.json'),
+  state: path.join(dir, '.l00prite/state.json'),
+  lock: path.join(dir, '.l00prite/lock.json'),
+  memory: path.join(dir, '.l00prite/memory.md'),
+  failures: path.join(dir, '.l00prite/failures.md'),
+  widget: path.join(dir, 'widget_cli.txt'),
+});
+
+// ---------------------------------------------------------------------------
+// Lock/lease helpers — implements templates/l00prite/LOCKING.md rules 1-5.
+// ---------------------------------------------------------------------------
+function checkAndAcquireLock(dir, agentId, sessionId, purpose, log) {
+  const paths = L(dir);
+  const lock = readJSON(paths.lock);
+  const now = Date.now();
+  const isFree = lock.status === 'unlocked' || lock.status === 'released';
+  const isExpired = lock.status === 'expired' || (lock.status === 'active' && lock.expires_at && Date.parse(lock.expires_at) < now);
+  const ownedByMe = lock.owner_agent === agentId && lock.owner_session === sessionId;
+  if (lock.status === 'active' && !isExpired && !ownedByMe) {
+    log(`lock.json is active, unexpired, owned by ${lock.owner_agent} (purpose: ${lock.purpose}) — this is the lock_lease_conflict boundary. Writing nothing.`);
+    return { ok: false, reason: 'lock_lease_conflict', lock };
+  }
+  if (isExpired) {
+    log(`lock.json is stale (status=${lock.status}, expires_at=${lock.expires_at}) — reclaiming per LOCKING.md rule 4; this must be recorded in ledger.md.`);
+  }
+  const newLock = {
+    schema_version: lock.schema_version || 1,
+    lock_id: `lock-${nowISO().replace(/[-:TZ]/g, '')}-${agentId}`,
+    owner_agent: agentId,
+    owner_session: sessionId,
+    acquired_at: nowISO(),
+    expires_at: new Date(now + (lock.ttl_seconds || 1800) * 1000).toISOString().replace(/\.\d+Z$/, 'Z'),
+    ttl_seconds: lock.ttl_seconds || 1800,
+    purpose,
+    protected_paths: lock.protected_paths,
+    status: 'active',
+  };
+  writeJSON(paths.lock, newLock);
+  log(`acquired lock ${newLock.lock_id} (purpose: "${purpose}").`);
+  return { ok: true, lock: newLock, wasStaleReclaim: isExpired && lock.status !== 'unlocked' };
+}
+
+function releaseLock(dir, log) {
+  const paths = L(dir);
+  const lock = readJSON(paths.lock);
+  lock.status = 'released';
+  lock.owner_agent = null;
+  lock.owner_session = null;
+  lock.purpose = null;
+  writeJSON(paths.lock, lock);
+  log(`released lock ${lock.lock_id}.`);
+}
+
+// ---------------------------------------------------------------------------
+// todos.md parsing — "## Next" section, lines shaped "- [ ] T<n>: ... (GATE: <kind>)?"
+// ---------------------------------------------------------------------------
+const WORK_LINE = {
+  T1: 'CMD list: implemented',
+  T2: 'CMD purge --all: implemented',
+  T3: 'CMD create: implemented',
+};
+
+function pickNextTodo(dir) {
+  const text = readText(L(dir).todos);
+  const lines = text.split('\n');
+  let inNext = false;
+  for (const line of lines) {
+    if (/^## Next/.test(line)) { inNext = true; continue; }
+    if (/^## /.test(line) && inNext) break;
+    if (!inNext) continue;
+    const m = line.match(/^- \[ \] (T\d+):/);
+    if (m) {
+      return { id: m[1], line, gated: line.includes('(GATE:') };
+    }
+  }
+  return null; // nothing unchecked left under "## Next"
+}
+
+function markTodoDone(dir, id, agentLabel) {
+  const paths = L(dir);
+  let text = readText(paths.todos);
+  const lines = text.split('\n');
+  const idx = lines.findIndex((l) => new RegExp(`^- \\[ \\] ${id}:`).test(l));
+  if (idx === -1) throw new Error(`markTodoDone: ${id} not found unchecked`);
+  lines[idx] = lines[idx].replace('- [ ]', '- [x]');
+  text = lines.join('\n');
+  // Drop the one-time "(none yet ...)" placeholder the first time something is actually
+  // done, then prepend an evidence line under "## Done" (never rewrites a prior Done line).
+  text = text.replace(/\(none yet[^\n]*\)\n/, '');
+  text = text.replace(
+    /## Done\n/,
+    `## Done\n- ${id} done by ${agentLabel} at ${nowISO()}.\n`
+  );
+  writeText(paths.todos, text);
+}
+
+function doWork(dir, id) {
+  const paths = L(dir);
+  const line = WORK_LINE[id];
+  fs.appendFileSync(paths.widget, line + '\n');
+  return line;
+}
+
+function verifyWork(dir, id) {
+  const paths = L(dir);
+  const content = fs.existsSync(paths.widget) ? readText(paths.widget) : '';
+  const ok = content.split('\n').filter((l) => l === WORK_LINE[id]).length >= 1;
+  return {
+    ok,
+    command: `node -e "process.exit(require('fs').readFileSync('widget_cli.txt','utf8').includes(${JSON.stringify(WORK_LINE[id])}) ? 0 : 1)"`,
+    exit_code: ok ? 0 : 1,
+    summary: ok ? `widget_cli.txt contains "${WORK_LINE[id]}"` : `widget_cli.txt missing "${WORK_LINE[id]}"`,
+    timestamp: nowISO(),
+  };
+}
+
+// ---------------------------------------------------------------------------
+// ledger.md append
+// ---------------------------------------------------------------------------
+function appendLedgerEntry(dir, agentLabel, fields) {
+  const paths = L(dir);
+  let text = readText(paths.ledger);
+  const entry = `
+### Run ${nowISO()} — ${agentLabel}
+- **Goal:** ${fields.goal}
+- **Triggering event:** none.
+- **Reviewer/comment reference:** none.
+- **Decision:** ${fields.decision}
+- **Completed work:** ${fields.completedWork}
+- **Fix implemented:** not applicable (execute-loop run, not an event fix).
+- **Changed files:** ${fields.changedFiles}
+- **Tests run / Verification:** ${fields.verification.map((v) => `command=\`${v.command}\`, exit_code=${v.exit_code}, summary="${v.summary}", timestamp=${v.timestamp}`).join(' | ') || 'none this run'}
+- **Response drafted/sent:** not applicable.
+- **Event status:** not applicable.
+- **Failures:** ${fields.failures}
+- **Decisions:** ${fields.decisions}
+- **Confidence:** ${fields.confidence}
+- **Next action:** ${fields.nextAction}
+- **Do-not-retry notes:** none.
+- **Lock:** ${fields.lock}
+`;
+  if (text.includes('(none yet')) {
+    text = text.replace(/## Runs\n\(none yet[^\n]*\)\n/, `## Runs\n${entry}`);
+  } else {
+    text = text + entry;
+  }
+  writeText(paths.ledger, text);
+}
+
+// ---------------------------------------------------------------------------
+// Logging
+// ---------------------------------------------------------------------------
+function makeLog(prefix) {
+  return (msg) => console.log(`[${prefix}] ${msg}`);
+}
+
+// ---------------------------------------------------------------------------
+// Agent A: fresh project, budget = 1 iteration. Does T1, hits iteration_limit_reached.
+// ---------------------------------------------------------------------------
+function agentA(dir) {
+  const log = makeLog('agent-A / vendor-claude-like');
+  const paths = L(dir);
+  const agentId = 'agent-A-vendor-claude';
+  const sessionId = `sess-A-${process.pid}`;
+
+  log('--- PRE-FLIGHT GATE ---');
+  log('step 1: reading blueprint.md, todos.md, memory.md, constraints.md, failures.md, heartbeat.json, state.json, lock.json.');
+  const hb = readJSON(paths.heartbeat);
+  const state = readJSON(paths.state);
+  log(`step 2: lock.json status="${readJSON(paths.lock).status}" — checked before any write.`);
+  log(`step 3: state.execution_active=${state.execution_active} — no stale-run recovery needed.`);
+  log(`step 4: heartbeat schema_version=${hb.schema_version}, execution block present — no migration needed.`);
+  log('step 5: PRE-FLIGHT DISPLAY');
+  log(`  goal: implement blueprint.md requirements R1-R3 for the widget-cli fixture`);
+  log(`  planned units (from todos.md "## Next"): T1, T2 (gated), T3`);
+  log(`  iteration budget: execution.current_iteration=${hb.execution.current_iteration} / execution.max_iterations=${hb.execution.max_iterations} (resets to 0 on confirmation)`);
+  log(`  run boundaries: ${hb.execution.run_boundaries.join(', ')}`);
+  log('  files likely to change: .l00prite/todos.md, .l00prite/ledger.md, .l00prite/state.json, .l00prite/heartbeat.json, widget_cli.txt');
+  log('  per-action permission required for: push, merge, deploy, credential changes (none planned this run)');
+  log('  verification: node -e check that the expected line was appended to widget_cli.txt');
+  log('step 6: SIMULATED HUMAN CONFIRMATION: "EXECUTE" -- this automated harness stands in for a');
+  log('  real human; see docs/cross-agent-compat-test.md for the manual protocol with a real human.');
+
+  const acq = checkAndAcquireLock(dir, agentId, sessionId, 'execute-loop run', log);
+  if (!acq.ok) { log('ABORT: ' + acq.reason); process.exit(3); }
+
+  log('step 7: arming the run.');
+  hb.execution.current_iteration = 0;
+  hb.execution.enabled = true;
+  hb.execution.preflight_confirmed = true;
+  hb.execution.preflight_confirmed_at = nowISO();
+  hb.execution.preflight_confirmed_by = `${agentId} (simulated human: automated-test-harness)`;
+  hb.should_continue = true;
+  writeJSON(paths.heartbeat, hb);
+  state.execution_active = true;
+  state.active_agent = agentId;
+  writeJSON(paths.state, state);
+
+  log('--- ITERATION PROTOCOL ---');
+  let boundary = null;
+  const completedThisRun = [];
+  while (true) {
+    const next = pickNextTodo(dir);
+    if (!next) { boundary = 'definition_of_done_met'; break; }
+    if (next.gated) {
+      log(`selected unit ${next.id} but it is GATE-tagged — this is the human_review_gate boundary. Stopping before executing it.`);
+      boundary = 'human_review_gate';
+      break;
+    }
+    log(`iteration ${hb.execution.current_iteration + 1}: executing unit ${next.id}.`);
+    doWork(dir, next.id);
+    const v = verifyWork(dir, next.id);
+    log(`verify: ${v.summary} (exit_code=${v.exit_code})`);
+    if (!v.ok) { boundary = 'unfixable_failing_tests'; break; }
+    markTodoDone(dir, next.id, agentId);
+    completedThisRun.push({ id: next.id, verification: v });
+    hb.execution.current_iteration += 1;
+    writeJSON(paths.heartbeat, hb);
+    if (hb.execution.current_iteration >= hb.execution.max_iterations) {
+      boundary = 'iteration_limit_reached';
+      break;
+    }
+  }
+
+  log(`--- MODE EXIT: boundary = ${boundary} ---`);
+  appendLedgerEntry(dir, agentId, {
+    goal: 'implement widget-cli fixture requirements R1-R3 (Execution Mode run 1)',
+    decision: 'Normal work; confirmed pre-flight, ran within iteration budget.',
+    completedWork: completedThisRun.length ? completedThisRun.map((c) => c.id).join(', ') + ' implemented and verified' : 'none',
+    changedFiles: completedThisRun.length ? 'widget_cli.txt, .l00prite/todos.md' : 'none',
+    verification: completedThisRun.map((c) => c.verification),
+    failures: 'none',
+    decisions: 'T2 is GATE-tagged (destructive) and was correctly left untouched.',
+    confidence: 'high — deterministic scripted run',
+    nextAction: boundary === 'iteration_limit_reached'
+      ? 'A new execute-loop pre-flight (any vendor) should confirm and continue with T2 (subject to its human review gate) and T3.'
+      : `boundary ${boundary} reached; see state.json.execution_stop_reason`,
+    lock: `${readJSON(paths.lock).lock_id ? 'acquired and released this run' : 'none'}`,
+  });
+  state.execution_active = false;
+  state.execution_stop_reason = boundary;
+  state.status = boundary === 'definition_of_done_met' ? 'done' : 'paused';
+  state.last_agent = agentId;
+  state.active_agent = null;
+  state.last_updated = nowISO();
+  state.next_recommended_action = boundary === 'iteration_limit_reached'
+    ? 'resume via a fresh, confirmed execute-loop pre-flight (any vendor) to continue with T2/T3'
+    : `boundary ${boundary}`;
+  writeJSON(paths.state, state);
+  hb.execution.enabled = false;
+  hb.execution.last_run_boundary = boundary;
+  hb.last_run_time = nowISO();
+  hb.completion_status = boundary === 'definition_of_done_met' ? 'complete' : 'in_progress';
+  hb.pause_reason = boundary === 'iteration_limit_reached'
+    ? 'iteration budget exhausted after T1; T2 (gated) and T3 remain'
+    : `stopped at ${boundary}`;
+  hb.should_continue = false;
+  writeJSON(paths.heartbeat, hb);
+  releaseLock(dir, log);
+  log(`done. boundary=${boundary}, current_iteration=${hb.execution.current_iteration}`);
+}
+
+// ---------------------------------------------------------------------------
+// Agent B: a DIFFERENT process (different vendor identity), invoked with only the
+// directory path — no in-memory state from Agent A. Reads .l00prite/, runs its own
+// fresh pre-flight, and continues.
+//
+// Compliant mode: resets the iteration budget via a fresh confirmed pre-flight, selects
+// the next unchecked unit (T2), finds it GATE-tagged, and stops at human_review_gate
+// without touching T1's completed work.
+//
+// Violating mode (--violating): simulates a non-compliant resumption that (a) reuses the
+// previous run's persisted preflight_confirmed_at/by instead of getting a fresh
+// confirmation, (b) redoes T1 (wasted duplicate work), and (c) barrels through the T2
+// gate anyway. Used only by `selftest` to prove the assertions below actually discriminate.
+// ---------------------------------------------------------------------------
+function agentB(dir, violating) {
