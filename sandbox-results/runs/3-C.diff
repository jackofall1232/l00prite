+  const paths = L(dir);
+  const agentId = 'agent-B-vendor-codex';
+  const sessionId = `sess-B-${process.pid}`;
+
+  log('--- PRE-FLIGHT GATE (fresh process, reading only .l00prite/ + repo files) ---');
+  const hb = readJSON(paths.heartbeat);
+  const state = readJSON(paths.state);
+  log(`step 1: read blueprint.md, todos.md, ledger.md, memory.md, heartbeat.json, state.json, lock.json.`);
+  log(`step 2: lock.json status="${readJSON(paths.lock).status}".`);
+  log(`step 3: state.execution_active=${state.execution_active}, execution_stop_reason="${state.execution_stop_reason}" — prior run's own exit, not a crash; no stale-run reclaim needed.`);
+  log(`step 4: heartbeat schema_version=${hb.schema_version} — no migration needed.`);
+  log('step 5: PRE-FLIGHT DISPLAY');
+  log(`  prior run's counter shown: execution.current_iteration=${hb.execution.current_iteration} / execution.max_iterations=${hb.execution.max_iterations} (this is agent A's leftover value; it resets to 0 on THIS confirmation, not before)`);
