+  const hbA = readJSON(paths.heartbeat);
+  const stateA = readJSON(paths.state);
+  const lockA = readJSON(paths.lock);
+  const todosA = readText(paths.todos);
+  const ledgerA = readText(paths.ledger);
+  const widgetA = readText(paths.widget);
+
+  a.check(hbA.execution.enabled === false, 'after Agent A: execution.enabled reset to false at mode exit');
+  a.check(hbA.execution.current_iteration === 1, 'after Agent A: execution.current_iteration === 1 (one unit completed)');
+  a.check(hbA.execution.max_iterations === 1, 'after Agent A: execution.max_iterations unchanged at 1');
+  a.check(hbA.execution.last_run_boundary === 'iteration_limit_reached', 'after Agent A: last_run_boundary === "iteration_limit_reached"');
+  a.check(stateA.execution_active === false, 'after Agent A: state.execution_active === false');
+  a.check(stateA.execution_stop_reason === 'iteration_limit_reached', 'after Agent A: state.execution_stop_reason === "iteration_limit_reached"');
