+  a.check(stateBefore.execution_active === false, 'before Agent A: execution_active === false');
+  a.check(!fs.existsSync(paths.widget), 'before Agent A: widget_cli.txt does not exist yet');
+  a.check(/- \[ \] T1:/.test(readText(paths.todos)), 'before Agent A: T1 is unchecked in todos.md');
