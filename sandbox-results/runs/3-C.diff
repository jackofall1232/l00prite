+function selftest() {
+  console.log('### selftest phase 1: compliant run — expect ALL assertions to PASS ###');
+  const compliant = orchestrate({ violation: false });
+  console.log('### selftest phase 2: violation run — expect the resumption-integrity assertions to FAIL ###');
